                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "judul",
                  "value": "Pemrograman Laravel",
                  "type": "text"
                },
                {
                  "key": "penulis",
                  "value": "Abdul Kadir",
                  "type": "text"
                },
                {
                  "key": "penerbit",
                  "value": "Andi Publisher",
                  "type": "text"
                },
                {
                  "key": "tahun_terbit",
                  "value": "2026",
                  "type": "text"
                },
                {
                  "key": "stok",
                  "value": "5",
                  "type": "text"
                },
                {
                  "key": "cover",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/books",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "books"
              ]
            }
          }
        },
