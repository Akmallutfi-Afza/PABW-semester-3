                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"book_id\": {{book_id}},\n  \"tanggal_pinjam\": \"2026-11-25\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
